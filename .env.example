# ==============================================================================
# Vision Loop — Fully Automated Asset Rental Platform Configuration
# ==============================================================================

# System & General
APP_NAME=VisionLoop
ENVIRONMENT=production
SECRET_KEY=visionloop-super-secure-production-secret-key-2026

# Unstructured Document Database (MongoDB)
MONGO_INITDB_ROOT_USERNAME=visionloop_admin
MONGO_INITDB_ROOT_PASSWORD=visionloop_secure_pass_2026
MONGO_INITDB_DATABASE=visionloop_db
MONGODB_URI=mongodb://visionloop_admin:visionloop_secure_pass_2026@db:27017/visionloop_db?authSource=admin
DATABASE_NAME=visionloop_db
REDIS_URL=redis://redis:6379/0

# Core API Service
CORE_API_PORT=8000
CORE_API_URL=http://core-api:8000

# Zoho Books Integration (OAuth 2.0 Credentials)
ZOHO_BOOKS_PORT=8001
ZOHO_BOOKS_URL=http://zoho-connector:8001
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_organization_id_here
ZOHO_API_DOMAIN=https://books.zoho.in/api/v3
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in

# Indian Statutory Tax Defaults
DEFAULT_SAC_CODE=997311
DEFAULT_GST_RATE=18.0
BASE_MONTHLY_RENT=72000.00

# AI Multi-Agent Service & LLM Configuration
AI_AGENT_PORT=8002
AI_AGENT_URL=http://ai-agent-service:8002
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-2.0-flash

# Telematics & IoT Ingestor
TELEMATICS_PORT=8003
TELEMATICS_URL=http://telematics-listener:8003
TELEMATICS_SIMULATION_INTERVAL_SEC=5
GEOFENCE_RADIUS_KM=80.0
GEOFENCE_CENTER_LAT=28.6139
GEOFENCE_CENTER_LNG=77.2090

# Telegram Bot & Push Alerts (Mobile Control Center)
TELEGRAM_BOT_PORT=8004
TELEGRAM_BOT_URL=http://telegram-bot:8004
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_or_group_id

# WhatsApp Cloud API & Notifications
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token

# Frontend Dashboard
DASHBOARD_PORT=3000
VITE_CORE_API_URL=http://localhost:8000
